# ────────────────────────────── 数据库 ──────────────────────────────
#
# 自建 PostgreSQL（PC 上的 Docker，见 ./pg/docker-compose.yml）。
# 服务端专用：**不要**加 NEXT_PUBLIC_ 前缀，否则会被打进浏览器包。
#
# 格式：postgresql://<用户>:<密码>@<主机>:<端口>/<库名>
DATABASE_URL=postgresql://loono:改我@192.168.31.37:5432/loono

# 连接池上限。Next.js dev 模式下模块会被反复热重载，池子开太大容易顶到
# 数据库的 max_connections（当前 200）。生产可按 worker 数上调。
DATABASE_POOL_MAX=10

# ────────────────────────────── 上传 ──────────────────────────────
#
# 会员照片的落盘目录。留空则用 `<项目根>/var/uploads`。
#
# 生产环境请把它指到**数据卷**上（例如容器里的 /data/uploads）：
# 项目目录在容器重建时会被替换，写在那里的照片会一起消失。
# 挂卷后同一份文件可以跨构建复用，也便于单独备份。
# UPLOAD_DIR=/data/uploads
